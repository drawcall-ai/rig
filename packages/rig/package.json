{
  "name": "@drawcall/rig",
  "version": "0.0.0",
  "description": "Three.js rigging runtime: load glTF assets, measure geometry, and compute skin weights from serialized skeletons.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drawcall-ai/rig.git",
    "directory": "packages/rig"
  },
  "bugs": {
    "url": "https://github.com/drawcall-ai/rig/issues"
  },
  "homepage": "https://github.com/drawcall-ai/rig#readme",
  "type": "module",
  "main": "./dist/node.js",
  "imports": {
    "#worker": {
      "node": "./dist/skin/worker/node.js",
      "default": "./dist/skin/worker/browser.js"
    }
  },
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm build && tsx test/worker.test.ts && tsx test/bind-snapshot.test.ts && tsx test/parity.test.ts && tsx test/rig.test.ts && tsx test/skeleton.test.ts && tsx test/loader.test.ts && tsx test/glts.test.ts && tsx test/pose.test.ts",
    "bench": "tsx scripts/bench.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "meshoptimizer": "^1.3.0"
  },
  "devDependencies": {
    "@drawcall/glts": "^1.0.0",
    "@types/node": "^22.19.3",
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "types": "./dist/node.d.ts"
}
