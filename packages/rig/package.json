{
  "name": "@drawcall/rig",
  "version": "0.0.0",
  "description": "Three.js rigging runtime: load glTF assets, measure geometry, compute skin weights from serialized skeletons, and rig faces with ARKit blendshapes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drawcall-ai/rig.git",
    "directory": "packages/rig"
  },
  "bugs": {
    "url": "https://github.com/drawcall-ai/rig/issues"
  },
  "homepage": "https://github.com/drawcall-ai/rig#readme",
  "type": "module",
  "sideEffects": [
    "./dist/skin/worker/run.js",
    "./dist/skin/worker/blur.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#model": {
      "node": "./dist/gltf/node.js",
      "default": "./dist/gltf/loader.js"
    },
    "#worker": {
      "node": "./dist/skin/worker/node.js",
      "default": "./dist/skin/worker/browser.js"
    },
    "#listen": {
      "node": "./dist/skin/worker/listen/node.js",
      "default": "./dist/skin/worker/listen/browser.js"
    },
    "#read": {
      "node": "./dist/face/rig/read/node.js",
      "default": "./dist/face/rig/read/browser.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "assets",
    "skills"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node scripts/build-wasm.mjs --check && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "pnpm build && tsc -p test/tsconfig.json && tsx test/wasm.test.ts && tsx test/worker.test.ts && tsx test/bind-snapshot.test.ts && tsx test/parity.test.ts && tsx test/rig.test.ts && tsx test/skeleton.test.ts && tsx test/model.test.ts && tsx test/cache.test.ts && tsx test/face-cache.test.ts && tsx test/pose.test.ts && tsx test/face.test.ts && tsx test/lazy.test.ts",
    "bench": "tsx scripts/bench.ts",
    "prepack": "pnpm build",
    "build:wasm": "node scripts/build-wasm.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@noble/hashes": "^2.0.1",
    "meshoptimizer": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "@drawcall/cache": "^0.8.2"
  },
  "peerDependencies": {
    "three": ">=0.171.0",
    "@drawcall/cache": "^0.8.2"
  }
}
