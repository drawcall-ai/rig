{
  "name": "@drawcall/rig",
  "version": "0.0.0",
  "description": "Tools for AI agents rigging any glTF with three.js in Node scripts: measure the mesh, build bones, compute skin weights, render checks, save.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drawcall-ai/rig.git",
    "directory": "packages/rig"
  },
  "bugs": {
    "url": "https://github.com/drawcall-ai/rig/issues"
  },
  "homepage": "https://github.com/drawcall-ai/rig#readme",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./three": "./src/three.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./three": {
        "types": "./dist/three.d.ts",
        "default": "./dist/three.js"
      }
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx test/parity.test.ts && tsx test/rig.test.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@napi-rs/canvas": "^1.0.9",
    "@onirenaud/node-webgl": "^0.2.0",
    "draco3dgltf": "^1.5.7",
    "meshoptimizer": "^1.3.0"
  },
  "devDependencies": {
    "@types/draco3dgltf": "^1.4.3",
    "@types/node": "^22.19.3",
    "@types/three": "^0.186.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "three": "^0.186.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  }
}
