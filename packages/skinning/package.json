{
  "name": "@drawcall/skinning",
  "version": "0.0.0",
  "description": "Automatic skin weights for any glTF: voxelize a mesh, give it a skeleton, get a skinned glTF back. Library for Node and the browser, plus a CLI built for AI agents.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "bin": {
    "skinning": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx test/parity.test.ts && tsx test/skin.test.ts && tsx test/cli.test.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "draco3dgltf": "^1.5.7",
    "meshoptimizer": "^1.3.0"
  },
  "devDependencies": {
    "@types/draco3dgltf": "^1.4.3",
    "@types/node": "^22.19.3",
    "gltf-validator": "2.0.0-dev.3.10",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
